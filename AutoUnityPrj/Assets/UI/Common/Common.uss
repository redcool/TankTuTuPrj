/* TankTuTu - Common.uss 全局样式系统 */
/* 军事主题 - 深色基调 + 军绿色强调 */

/* ========== 全局默认字体 ========== */
* {
    -unity-font-definition: url("project://database/Assets/Arts/Fonts/JyunsaiKaai-Regular SDF.asset");
}

/* ========== 设计Token ========== */
/* 色彩系统 */
:root {
    --color-bg-dark: #1a1a1a;
    --color-bg-panel: #222222;
    --color-bg-card: #2a2a2a;
    --color-bg-card-hover: #333333;
    --color-primary: #4a7c3f;        /* 军绿 */
    --color-primary-light: #6ba35e;
    --color-primary-dark: #2d5c24;
    --color-accent: #c8a84e;         /* 军铜 */
    --color-accent-light: #dcc46e;
    --color-danger: #8b3a3a;
    --color-danger-light: #b54a4a;
    --color-text-primary: #e0e0e0;
    --color-text-secondary: #a0a0a0;
    --color-text-disabled: #606060;
    --color-border: #3a3a3a;
    --color-border-focus: #4a7c3f;
    --color-health: #c84444;
    --color-energy: #4488cc;
    --color-gold: #d4a844;
    --color-rarity-common: #aaaaaa;
    --color-rarity-rare: #4488cc;
    --color-rarity-epic: #8844cc;
    --color-rarity-legendary: #cc8833;

    /* 间距系统 */
    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 16px;
    --space-lg: 24px;
    --space-xl: 32px;

    /* 圆角 */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;

    /* 字体 */
    --font-title: "Rajdhani", "JyunsaiKaai-Regular SDF", sans-serif;
    --font-body: "JyunsaiKaai-Regular SDF", "Noto Sans SC", sans-serif;
    --font-mono: "Rajdhani", monospace;

    /* 字号 */
    --text-xs: 12px;
    --text-sm: 14px;
    --text-md: 16px;
    --text-lg: 20px;
    --text-xl: 26px;
    --text-xxl: 32px;
    --text-hero: 48px;
}

/* ========== 全局 ========== */
* {
    font-size: var(--text-md);
    color: var(--color-text-primary);
}

/* ========== 面板容器 ========== */
.panel {
    background-color: var(--color-bg-panel);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--space-md);
}

.panel-dark {
    background-color: var(--color-bg-dark);
    border-width: 0;
    padding: var(--space-lg);
}

.card {
    background-color: var(--color-bg-card);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--space-md);
    transition: background-color 0.2s;
}

.card:hover {
    background-color: var(--color-bg-card-hover);
    border-color: var(--color-primary);
}

.card-selected {
    border-color: var(--color-primary);
    border-width: 2px;
    background-color: rgba(74, 124, 63, 0.15);
}

.card-locked {
    opacity: 0.5;
    background-color: var(--color-bg-card);
}

/* ========== 按钮 ========== */
.btn {
    font-size: var(--text-lg);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-lg);
    min-width: 120px;
    min-height: 40px;
    transition: background-color 0.15s, border-color 0.15s;
    cursor: pointer;
}

.btn-primary {
    background-color: var(--color-primary);
    border-color: var(--color-primary-light);
    color: white;
}

.btn-primary:hover {
    background-color: var(--color-primary-light);
}

.btn-primary:active {
    background-color: var(--color-primary-dark);
}

.btn-secondary {
    background-color: transparent;
    border-color: var(--color-border);
    color: var(--color-text-primary);
}

.btn-secondary:hover {
    background-color: var(--color-bg-card-hover);
    border-color: var(--color-text-secondary);
}

.btn-danger {
    background-color: var(--color-danger);
    border-color: var(--color-danger-light);
    color: white;
}

.btn-danger:hover {
    background-color: var(--color-danger-light);
}

.btn-small {
    font-size: var(--text-sm);
    padding: var(--space-xs) var(--space-sm);
    min-width: 80px;
    min-height: 30px;
}

.btn-icon {
    background-color: transparent;
    border-width: 0;
    min-width: 40px;
    min-height: 40px;
    padding: var(--space-xs);
}

.btn-icon:hover {
    background-color: var(--color-bg-card-hover);
}

/* ========== 文本 ========== */
.heading-hero {
    font-size: var(--text-hero);
    color: var(--color-text-primary);
    letter-spacing: 4px;
    text-align: center;
}

.heading-xl {
    font-size: var(--text-xl);

    color: var(--color-text-primary);
}

.heading-md {
    font-size: var(--text-lg);
    color: var(--color-text-primary);
}

.text-body {
    font-size: var(--text-md);
    color: var(--color-text-primary);
}

.text-secondary {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
}

.text-disabled {
    color: var(--color-text-disabled);
}

.text-gold {
    color: var(--color-gold);
}

.text-health {
    color: var(--color-health);
}

.text-energy {
    color: var(--color-energy);
}

.text-rarity-common { color: var(--color-rarity-common); }
.text-rarity-rare { color: var(--color-rarity-rare); }
.text-rarity-epic { color: var(--color-rarity-epic); }
.text-rarity-legendary { color: var(--color-rarity-legendary); }

.text-center {
    text-align: center;
}

/* ========== 进度条 ========== */
.progress-bar {
    min-height: 16px;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-dark);
}

.progress-bar-fill {
    border-radius: var(--radius-sm);
    transition: width 0.3s;
}

.progress-bar-fill-health {
    background-color: var(--color-health);
}

.progress-bar-fill-energy {
    background-color: var(--color-energy);
}

.progress-bar-fill-exp {
    background-color: var(--color-primary);
}

/* ========== 稀有度边框 ========== */
.rarity-common { border-color: var(--color-rarity-common); }
.rarity-rare { border-color: var(--color-rarity-rare); }
.rarity-epic { border-color: var(--color-rarity-epic); }
.rarity-legendary { border-color: var(--color-rarity-legendary); }

/* ========== 滚动视图 ========== */
.scroll-view {
    background-color: transparent;
}

/* ========== 分隔线 ========== */
.divider {
    height: 1px;
    background-color: var(--color-border);
    margin: var(--space-md) 0;
}

/* ========== 标签 ========== */
.tag {
    font-size: var(--text-xs);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--color-border);
    background-color: var(--color-bg-dark);
    color: var(--color-text-secondary);
}

.tag-tank { border-color: var(--color-primary); color: var(--color-primary-light); }
.tag-light { border-color: var(--color-energy); color: var(--color-energy); }
.tag-apc { border-color: var(--color-gold); color: var(--color-gold); }
.tag-spg { border-color: var(--color-danger); color: var(--color-danger-light); }
.tag-special { border-color: var(--color-accent); color: var(--color-accent); }
