/* WeaponCard.uss — 武器卡片样式 */

.wc-card {
    width: 280px;
    background-color: var(--color-bg-card);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: 16px;
    align-items: center;
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s;
}

.wc-card:hover {
    background-color: var(--color-bg-card-hover);
    border-color: var(--color-primary);
}

.wc-card.selected {
    border-color: var(--color-primary);
    border-width: 2px;
    background-color: rgba(74, 124, 63, 0.15);
}

.wc-icon {
    width: 200px;
    height: 200px;
    background-color: var(--color-bg-dark);
    border-radius: var(--radius-sm);
    justify-content: center;
    align-items: center;
    margin-bottom: 8px;
    overflow: hidden;
}

.wc-icon-image {
    width: 200px;
    height: 200px;
}

.wc-name {
    font-size: var(--text-md);
    text-align: center;
    margin-bottom: 4px;
}

.wc-dmg {
    font-size: var(--text-xs);
}

.wc-tags {
    flex-direction: row;
    gap: 4px;
    margin-top: 4px;
}
